# Asana App Credentials (from developers.asana.com)
ASANA_APP_CLIENT_ID=your_client_id
ASANA_APP_CLIENT_SECRET=your_client_secret

# Server Config
PORT=3000
BASE_URL=https://your-domain.com

# Asana Workspace GID
ASANA_WORKSPACE_GID=1207860012563297

# "Time Tracked" custom field GID (created via POST /setup/create-time-field)
TIME_TRACKED_FIELD_GID=
